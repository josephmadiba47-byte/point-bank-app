generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  relationMode = "prisma"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model User {
  id                   String        @id @default(cuid())
  name                 String?
  email                String?       @unique
  password             String?
  phone                String?
  address              String?
  idType               String?       // e.g. "PASSPORT", "DRIVERS_LICENSE"
  idNumber             String?
  idDocumentUrl        String?       // Public Supabase Storage URL
  kycStatus            String        @default("UNVERIFIED") // UNVERIFIED, PENDING, VERIFIED, REJECTED
  accountTier          String        @default("STANDARD") // STANDARD, SILVER, GOLD, PLATINUM
  accountOfficerName   String?       // <-- ADD THIS
  accountOfficerEmail  String?
  passText             String?
  twoFactorEnabled     Boolean       @default(false) 
  role                 String        @default("USER")
  isSuspended          Boolean       @default(false)
  accountNo            Int           @unique @default(autoincrement())
  emailVerified        DateTime?
  image                String?
  accounts             Account[]
  sentTransactions     Transaction[] @relation("SentTransactions")
  receivedTransactions Transaction[] @relation("ReceivedTransactions")
  beneficiaries        Beneficiary[]
  loans                Loan[]
  knownDevices         KnownDevice[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}
model TwoFactorToken {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}
model KnownDevice {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fingerprint String   // Hash of User-Agent + IP prefix
  deviceLabel String   // e.g. "Chrome on Windows"
  ipAddress   String
  lastSeenAt  DateTime @default(now())

  @@unique([userId, fingerprint])
  @@index([userId])
}
model Loan {
  id           String   @id @default(cuid())
  amount       Int
  totalPayable Int
  termMonths   Int
  interestRate Float
  purpose      String
  status       String   @default("PENDING") // PENDING, APPROVED, REJECTED, PAID
  createdAt    DateTime @default(now())

  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}


model Beneficiary {
  id          String   @id @default(cuid())
  accountName String
  accountNo   String
  systemName  String
  routingNo   String
  createdAt   DateTime @default(now())

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, accountNo, routingNo])
  @@index([userId])
}


model Transaction {
  id                   String   @id @default(cuid())
  amount               Int
  description          String
  createdAt            DateTime @default(now())
  authCode             String?

  // External Wire Recipient Details
  recipientName        String?
  recipientAccountNo   String?
  recipientSystemName  String?
  routingNumber        String?

  senderId             String?
  sender               User?    @relation("SentTransactions", fields: [senderId], references: [id])

  // Make receiverId optional since external recipients are outside this system
  receiverId           String?
  receiver             User?    @relation("ReceivedTransactions", fields: [receiverId], references: [id])

  @@index([senderId])
  @@index([receiverId])
}

model SystemSettings {
  id             String   @id @default("global")
  vaultName      String   @default("PointVault")
  supportEmail   String   @default("compliance@pointvault.io")
  supportPhone   String   @default("+234 800 000 0000")
  officeAddress  String   @default("12 Marina Road, Lagos, Nigeria")
  operatingHours String   @default("Mon – Fri, 8:00 AM – 6:00 PM WAT")
  noticeBanner   String?  // Optional global announcement banner for users
  updatedAt      DateTime @updatedAt
}
